{
  "manifest_version": 3,
  "name": "Video Resumer (jipai)",
  "version": "1.0.0",
  "description": "Resumes YouTube videos where you left off. Event-driven, main player only, ignores hover previews and ads.",
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*", "*://m.youtube.com/*"],
      "js": ["resume.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://www.youtube-nocookie.com/embed/*", "*://www.youtube.com/embed/*"],
      "js": ["resume.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "video-resumer@jipai",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
