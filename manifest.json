{
  "manifest_version": 3,
  "name": "Resume Playback for YouTube",
  "version": "1.0.0",
  "description": "Makes YouTube on Firefox continue from the hover preview when you click a video, like Chrome, and resumes videos where you left off.",
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*"
      ],
      "js": [
        "cleanup.js",
        "resume.js"
      ],
      "run_at": "document_start",
      "exclude_matches": [
        "*://www.youtube.com/embed/*"
      ]
    },
    {
      "matches": [
        "*://www.youtube-nocookie.com/embed/*",
        "*://www.youtube.com/embed/*"
      ],
      "js": [
        "cleanup.js",
        "resume.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "resume-playback-for-youtube@jipaix",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "options_ui": {
    "page": "options.html"
  },
  "homepage_url": "https://github.com/JiPaix/resume-playback-for-youtube",
  "action": {
    "default_title": "Resume Playback for YouTube",
    "default_popup": "options.html",
    "default_icon": {
      "16": "icon.svg",
      "32": "icon.svg"
    }
  }
}
